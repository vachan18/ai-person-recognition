# Copy this file to .env and adjust. The real .env is git-ignored.

# Secret key for Flask sessions/signing. If unset, a random key is generated
# on each start (safe, but sessions reset on restart).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Host/port for the local server. 127.0.0.1 keeps it reachable only from this PC.
HOST=127.0.0.1
PORT=5000

# Set to 1 only during development (enables the debugger and auto-reload).
FLASK_DEBUG=0
